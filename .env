# Google Gemini API Key
GEMINI_API_KEY=AQ.Ab8RN6Kb0tn6qdETvS2L8PvIGKXqFSVBpuauCwVl6zOhSws1Zg

# Gemini Model Selection
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (Set to SQLite for instant local execution without MySQL)
MYSQL_URL=sqlite:///./storage/companion.db
# To use MySQL instead, uncomment and configure:
# MYSQL_URL=mysql+pymysql://root:password@localhost:3306/multimodal_companion

# Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=8501

# Max Upload Size (in Megabytes)
MAX_UPLOAD_SIZE_MB=25

# RAG Configuration
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
